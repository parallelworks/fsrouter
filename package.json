{
  "name": "@parallelworks/fsrouter",
  "type": "commonjs",
  "version": "0.2.3",
  "description": "Filesystem based router for Express.js",
  "author": "Michael McQuade",
  "license": "Apache-2.0",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parallelworks/fsrouter.git"
  },
  "homepage": "https://github.com/parallelworks/fsrouter#readme",
  "bugs": "https://github.com/parallelworks/fsrouter/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "express": "^4.22.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "express": "^4.17.1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "glob": "^9.3.5",
    "json-schema-to-ts": "^2.12.0"
  }
}
